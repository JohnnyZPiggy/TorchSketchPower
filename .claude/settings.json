{
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Edit(src/**)",
      "Edit(tests/**)",
      "Edit(docs/**)",
      "Write(src/**)",
      "Write(tests/**)",
      "Write(docs/**)",
      "Bash(pytest:*)",
      "Bash(py -m pytest:*)",
      "Bash(PYTHONPATH=src py -m pytest:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git ls-remote:*)",
      "Bash(git fetch:*)",
      "Bash(git push origin feat/*)",
      "Bash(git push --dry-run:*)",
      "PowerShell(git status:*)",
      "PowerShell(git diff:*)",
      "PowerShell(git log:*)",
      "PowerShell(git add:*)",
      "PowerShell(git commit:*)",
      "PowerShell(git push origin feat/*)",
      "PowerShell(py -m pytest:*)"
    ],
    "ask": [
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(pip install:*)"
    ],
    "deny": [
      "Edit(.sae/**)",
      "Write(.sae/**)",
      "Edit(.github/**)",
      "Write(.github/**)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin main:*)",
      "Bash(git reset --hard:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh repo delete:*)",
      "PowerShell(git push --force:*)",
      "PowerShell(git push -f:*)",
      "PowerShell(git push origin main:*)",
      "PowerShell(git reset --hard:*)",
      "PowerShell(gh pr merge:*)"
    ]
  }
}
